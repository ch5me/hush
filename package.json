{
  "name": "hush-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://git.ch5.me/ch5/hush.git"
  },
  "workspaces": [
    "hush-cli",
    "docs"
  ],
  "description": "Hush CLI and documentation monorepo",
  "scripts": {
    "build": "bun run --filter @chriscode/hush build && (cd docs && bun x astro build)",
    "test": "bun run --filter '*' test",
    "dev": "bun run --filter @chriscode/hush dev && (cd docs && bun x astro dev)",
    "type-check": "bun run --filter '*' type-check",
    "cli:build": "bun run --filter @chriscode/hush build",
    "cli:test": "bun run --filter @chriscode/hush test",
    "cli:test:coverage": "cd hush-cli && bun x vitest run --coverage",
    "cli:install-local": "node scripts/install-local.mjs",
    "cli:verify-local-install": "node hush-cli/scripts/verify-local-install.mjs",
    "docs:dev": "cd docs && bun x astro dev",
    "docs:build": "cd docs && bun x astro build",
    "docs:preview": "cd docs && bun x astro preview",
    "docs:deploy": "cd docs && bun x astro build && bun run deploy",
    "changelog": "./scripts/changelog.sh",
    "release": "./scripts/release.sh",
    "svc:ensure": "./node_modules/.bin/devmux ensure docs",
    "svc:status": "./node_modules/.bin/devmux status --json",
    "svc:stop": "./node_modules/.bin/devmux stop all"
  },
  "devDependencies": {
    "@chriscode/devmux": "1.15.6"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "picomatch": "4.0.5",
    "postcss": "8.5.23",
    "rollup": "4.59.0",
    "smol-toml": "1.6.1",
    "svgo": "4.0.2",
    "vite": "8.1.4"
  }
}
